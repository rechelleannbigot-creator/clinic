PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Firebase project associated with the web app in src/services/firebase.jsx.
FIREBASE_PROJECT_ID=clinic-management-system-c98ba
FIREBASE_STORAGE_BUCKET=clinic-management-system-c98ba.firebasestorage.app

# Path to your Firebase Admin service account JSON file.
# Keep this file private and NEVER put it inside src/ or commit it to Git.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Configure a Gmail app password or another SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-clinic-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
MAIL_FROM="Clinic Management System <your-clinic-email@gmail.com>"

# Optional: full frontend login URL. Example: http://localhost:5173/
LOGIN_URL=http://localhost:5173/
